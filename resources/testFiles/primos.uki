## Este programa calcula los números primos hasta un N indicado. ##
PRIMOS {
    uint MODULO (uint X, uint Y) {
        uint AUX;

        AUX := X + Y;
        do { AUX := AUX - Y; } while ( AUX >= Y );

        return (AUX);
    }

    uint N;
    N := 100UI;

    uint AUX1, AUX2, RESTO, CANT;
    AUX1 := 2UI;
    print("Números primos hasta: ");
    print(N);
    print("----------------------");
    do {
        AUX2 := 2UI;
        CANT := 0UI;
        do {
            RESTO := MODULO(AUX1->X,AUX2->Y);
            if (RESTO == 0UI)
                CANT := CANT + 1UI;
            endif;
            AUX2 := AUX2 + 1UI;
        } while (AUX2 <= AUX1);
        if (CANT == 1UI) {
            print(AUX1);
        } endif;
        AUX1 := AUX1 + 1UI;
    } while (AUX1 <= N);
    print("----------------------");

}