MAIN {

    uint A;

    if (A > 3UI) {

        print(4UI);
    } else {
    
        do {

            A := A + 1UI;

            if (A =! 2UI) {

                do {
                
                    A := A - 1UI;

                } while (A >= 1UI);

            } endif;
        
        } while (A > 9UI);
    } endif;
}
