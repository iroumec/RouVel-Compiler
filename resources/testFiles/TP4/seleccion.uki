IF {
    ## If simple ##
    if (A > B) {                                                        ## If simple ##
        A := A + 1UI;
    } endif;

    ## If-else ##
    if (B < C) {                                                        ## If con else ##   
        B := B + 1UI;
    } else {
        B := B - 1UI;
    } endif;

    ## If-else anidado dentro de un if-else ##
    if (C == 13.) {                                                     ## If con else if y else, con comparación ##
        C := C + 1UI;                                                   ## entre variable uint y constante float ##
    } else {
        if (D =! E) {
            D := D + 1UI;
        } else {
            D := D - 1UI;
        } endif;
    } endif;

    ## If-else con múltiples anidaciones ##
    if (E >= F)                                                         ## If con else ifs anidados ##
        E := E + 1UI;
    else if (F <= A)
        F := F + 1UI;
    else if (A =! B) 
        F := F - 1UI;
    else
        A := A - 1UI;
    endif;
    endif;
    endif;

    if (G >= H) {
        G := G + 1UI;
    } else {
        if (H <= F) {
            if (H <= A) {
                if (H <= B) {

                }
                if (H <= C) {

                } else {
                    if (C <= A) {
                        
                    }
                }
            }
        }
    }
}