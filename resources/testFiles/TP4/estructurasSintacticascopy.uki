ESTRUCTURASSINTACTICAS {            ## Longitud de ID > 20, se truncará. ##
    ## ------ Declaración de variables ------ ##
    uint A;                         ## Declaración de una variable ##
    uint B, C;                      ## Declaración de dos variables ##
    uint D, E, F;                   ## Declaración de múltiples variables ##

    ## ------ Declaración de función ------ ##
    uint SUMA(uint X, uint Y) {     ## Declaración de funcion con punto y coma ##
        return (X + Y);
    };

    uint RESTA(uint X, uint Y) {    ## Declaración de función sin punto y coma ##
        return (X - Y);
    }

    uint FUNCION(cvr uint P1, uint P2) {    ## Declaración de función con cvr ##
        if (P2 > P1) {
            P1 := P1 + 1UI;                 ## Modificación de P1 que se verá reflejada (si se ejecuta) ##
            return (P2);
        } else {
            if(ESTRUCTURASSINTACTICAS.SUMA(P2->Y,P1->X) < 10UI) {   ## Acceso a función fuera del scope, con parámetros en distinto orden al declarado ##
                P2 := P2 - 1UI;
                return (P2);
            } else {
                return (0UI);
            } endif;
        } endif;
    }                                       ## Retornos en los if y else anidados ##

    uint NADA(uint X) {          
        return (X)
    };

    ## ------ Invocación a función ------ ##
    ##NADA(0UI->X);##                     ## Llamada a función sin uso del valor de retorno ##

    ## ------ Asignación simple ------ ##
    A := 1UI;                               ## Asignación simple con constante ##
    B := 4UI * 5UI - 6UI / 7UI;             ## Asignación con expresión aritmética ##
    ##C := 8UI * SUMA(9UI->X,10UI->Y) / 11UI;## ## Asignación con expresión aritmética con llamada a función ##

    ## ------ Asignación múltiple ------ ##
    D, E, F = 12UI, 13., 14UI;            ## Asignación múltiple equilibrada, con conversión implícita ##
    D, E = -15., 16UI, 17.;                  ## Asignación múltiple con más constantes que variables, con conversión implícita (tomando valor absoluto) ##

    ## ------ Impresión ------ ##
    print(A);                           ## Impresión de variable entera ##
    print(18UI);                       ## Impresión de constante entera ##
    print(19.);                         ## Impresión de constante flotante ##
    print("Hola Mundo");              ## Impresión de cadena de caracteres ##
    print(5.*A);                    ## Impresión de resultado expresión aritmética ##
    ##print(RESTA(C->Y,B->X));##          ## Impresión de retorno de función ##

    ## ------ Estructura de control if ------ ##
    if (A > B) {                ## If simple ##
        A := A + 1UI;
    } endif;





    

    ## Estructura de control do-while ##


    
    ## Expresiones Lambda ##
                                ## Llamada a lambda con impresión ##
}