## En este programa se exploran los diferentes casos declarativos semánticamente válidos ##
DECLARATIVOS {
    uint A;

    uint H(uint X) {
        return(X*DECLARATIVOS.A);
    }
    
    A := 1UI;

    uint F(uint X) {
        uint A;
        A := 5UI;
        A := DECLARATIVOS.A + A;

        uint G(uint F) {
            F := DECLARATIVOS.H(5UI->X);

            uint A(cvr uint A) {
                A := 1UI;
                return (A);
            }

            return (F);
        }

        uint B(uint X) {
            X := DECLARATIVOS.F(F.B(F.A->X)->X);
            uint A;
            A := F.A + DECLARATIVOS.A;
            DECLARATIVOS.A := F.G(A->F);
            return(F.A);
        }

        A := B(DECLARATIVOS.A->X) + DECLARATIVOS.H(1UI->X) + G(2UI->F);
        return(A);
    }

    print(A);
}