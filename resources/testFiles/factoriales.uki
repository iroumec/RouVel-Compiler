FACTORIAL {

    uint FACT(uint X) {
        uint RESTA(uint A, uint B) {
            return (A - B);
        }

        if (X == 1UI) {
            return(1UI);
        } endif;

        uint Y;
        Y := FACTORIAL.RESTA(X->A,1UI->B);

        return (X*FACTORIAL.FACT(Y->X));
    } 

    uint A;

    A := 1UI;

    do {
        print("");
        print("El factorial de ");
        print(A);
        print("es:");

        print(FACT(A->X));

        A := A + 1UI;
    } while (A < 7UI);
}