## En este programa se exploran las diferentes estructuras sintácticas del lenguaje ##
SINTACTICAS{
    uint A, B, C;                       ## 1. Declaración de variables ##

    uint FUNC(uint X) {                 ## 2. Declaración de función ##
        return(X); 
    };   

    A := 0UI;                           ## 3. Asignación simple ##

    B, C = 1UI, 2UI;                    ## 4. Asignación múltiple ##

    if (A == 0UI) {                     ## 5. Estructura de control if ##
        A := A + 1UI;
    } else {
        A := A - 1UI;
    } endif;

    do { 
        B := B + 1UI; 
    } while (B < 5UI);                  ## 6. Estructura de control do while ##

    FUNC(6UI->X);                       ## 7. Invocación a función ##

    print(A);                           ## 8. Impresión ##

    (uint G) { print(G); }(25UI);       ## 9. Expresión lambda ##
}