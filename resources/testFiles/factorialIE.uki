FACTORIAL {

    uint FACT(uint X) {

        if (X == 0UI) {
            return(1UI);
        } else if (X == 1UI){
            return(1UI);
        } endif; endif;

        return (X*FACTORIAL.FACT(X-1UI->X));

    } 

    uint A;

    A := 6UI;

    print("El factorial de ");
    print(A);
    print("es:");

    print(FACT(A->X));
}