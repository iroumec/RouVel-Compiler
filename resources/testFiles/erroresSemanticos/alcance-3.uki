## Este programa no ejecutará por errores semánticos de alcance ##
ALCANCE {
    uint F (uint X) {
        uint A (uint Y) {
            uint B;
            return (Y*B);
        }
        ALCANCE.B := 2UI;       ## El identificador 'B' no corresponde a ninguna variable/función declarada en el ámbito 'ALCANCE'. ##
        return (A(2UI->Y));
    }

    print(F(2UI->X));
}