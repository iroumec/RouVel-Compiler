## Este programa no ejecutara por error semántico en el pasaje de parametros. ##
FUNCIONES {

    uint FUNCIONCVR (cvr uint X, uint Y) {
        X := 5UI;
        return (Y+X);
        X := 2UI;       ## Warning semántica ##
    }

    uint A;
    A := 1UI;

    A := FUNCIONCVR(1UI->X,A->Y);   ## Invocación a función con argumento no referenciable como parametro CVR ##       
}