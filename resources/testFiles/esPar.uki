MAIN {
    uint ESPAR (uint X) {
        uint AUX;

        AUX := X + 2UI;
        do { AUX := AUX - 2UI; } while ( AUX >= 2UI );

        print("Numero: ");
        print(X);
        if (AUX == 1UI)
            print("El número es impar.");
        else
            print("El número es par.");
        endif;
        return (AUX);
    }

    uint NUMERO;
    NUMERO := 13UI;

    ESPAR(NUMERO->X);
}