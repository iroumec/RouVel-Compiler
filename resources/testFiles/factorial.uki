FACTORIAL {

    uint A;

    uint FACT(uint X) {

        if (X == 1UI) {
            return(1UI);
        } else if (X == 0UI) {
            return (1UI);
        } else {
            return (X*FACTORIAL.FACT(X-1UI->X));
        } endif;
        endif;

        return(0UI);
    }

    A := 5UI;

    print("El factorial de 5 es: ");
    print(FACT(A->X));
}