FACTORIAL {

    uint FACT(uint X) {
        if (X <= 1UI) {
            return(1UI);
        } else {
            return (X*FACTORIAL.FACT(X-1UI->X));
        } endif;
    } 

    uint A;

    ## SETEAR 'A' CON EL VALOR QUE DESEA CALCULAR SU FACTORIAL ##
    A := 6UI;

    print("El factorial de ");
    print(A);
    print("es:");

    print(FACT(A->X));
}