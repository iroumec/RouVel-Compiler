  23                 | error ';'

  24  statement : executable_statement
  25            | declarative_statement

  26  declarative_statement : declaration_of_variables
  27                        | declaracion_funcion punto_y_coma_opcional

  28  punto_y_coma_opcional :
  29                        | ';'

  30  cuerpo_ejecutable : executable_statement
