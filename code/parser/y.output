  45  declaration_of_variables : UINT list_of_identifiers ';'
  46                           | UINT list_of_identifiers error
  47                           | UINT identifier DASIG constant ';'
  48                           | UINT error

  49  list_of_identifiers : identifier
  50                      | list_of_identifiers ',' identifier
  51                      | list_of_identifiers ID

  52  identifier : ID

  53  asignacion_simple : assignment_start expression ';'
  54                    | variable DASIG expression error
  55                    | variable expression ';'
  56                    | variable DASIG error

  57  assignment_start : variable DASIG

  58  multiple_assignment : list_of_variables list_of_constants ';'
  59                      | list_of_variables list_of_constants error

  60  list_of_variables : variable '='
  61                    | variable ',' list_of_variables
  62                    | variable error list_of_variables

  63  list_of_constants : constant
  64                    | list_of_constants ',' constant
  65                    | list_of_constants constant

  66  expression : term
  67             | expression operador_suma term
  68             | expression operador_suma error
  69             | expression term_simple
  70             | '+' term

  71  operador_suma : '+'
  72                | '-'

  73  term : term operador_multiplicacion factor
  74       | factor
  75       | term operador_multiplicacion error
  76       | operador_multiplicacion factor

  77  term_simple : term_simple operador_multiplicacion factor
  78              | factor_simple
  79              | term_simple operador_multiplicacion error

  80  operador_multiplicacion : '/'
  81                          | '*'

  82  factor : variable
  83         | constant
  84         | invocacion_funcion

  85  factor_simple : variable
  86                | CTE
  87                | invocacion_funcion

  88  constant : CTE
  89           | '-' CTE

  90  variable : ID
  91           | ID '.' ID

  92  condicion : '(' cuerpo_condicion ')'
  93            | '(' ')'
  94            | cuerpo_condicion ')'
  95            | '(' cuerpo_condicion error

  96  cuerpo_condicion : expression comparador expression
  97                   | expression term_simple
  98                   | expression operador_suma term
  99                   | term

 100  comparador : '>'
 101             | '<'
 102             | EQ
 103             | LEQ
 104             | GEQ
 105             | NEQ
 106             | '='

 107  if : if_start cuerpo_if
 108     | IF error

 109  $$4 :

 110  if_start : IF $$4 condicion

 111  cuerpo_if : cuerpo_ejecutable rama_else ENDIF ';'
 112            | cuerpo_ejecutable rama_else ENDIF error
 113            | cuerpo_ejecutable rama_else error
 114            | cuerpo_ejecutable rama_else ';'
 115            | rama_else ENDIF ';'

 116  rama_else :
 117            | else_start cuerpo_ejecutable
 118            | else_start

 119  else_start : ELSE

 120  do_while : do_while_start cuerpo_iteracion ';'
 121           | do_while_start cuerpo_iteracion error
