  38                       | multiple_assignment
  39                       | sentencia_control
  40                       | sentencia_retorno
  41                       | impresion
  42                       | lambda

  43  sentencia_control : if
  44                    | do_while

  45  declaration_of_variables : UINT list_of_identifiers ';'
  46                           | UINT list_of_identifiers error
  47                           | UINT identifier DASIG constant ';'
  48                           | UINT error

  49  list_of_identifiers : identifier
  50                      | list_of_identifiers ',' identifier
  51                      | list_of_identifiers ID

  52  identifier : ID

  53  asignacion_simple : variable DASIG expression ';'
  54                    | variable DASIG expression error
  55                    | variable expression ';'
  56                    | variable DASIG error

  57  multiple_assignment : list_of_variables list_of_constants ';'
  58                      | list_of_variables list_of_constants error

  59  list_of_variables : variable '='
  60                    | variable ',' list_of_variables
  61                    | variable error list_of_variables

  62  list_of_constants : constant
  63                    | list_of_constants ',' constant
  64                    | list_of_constants constant

  65  expression : term
  66             | expression operador_suma term
  67             | expression operador_suma error
  68             | expression term_simple
  69             | '+' term

  70  operador_suma : '+'
  71                | '-'

  72  term : term operador_multiplicacion factor
  73       | factor
  74       | term operador_multiplicacion error
  75       | operador_multiplicacion factor

  76  term_simple : term_simple operador_multiplicacion factor
  77              | factor_simple
  78              | term_simple operador_multiplicacion error

  79  operador_multiplicacion : '/'
  80                          | '*'

  81  factor : variable
  82         | constant
  83         | invocacion_funcion

  84  factor_simple : variable
  85                | CTE
  86                | invocacion_funcion

  87  constant : CTE
  88           | '-' CTE

  89  variable : ID
  90           | ID '.' ID

  91  condicion : '(' cuerpo_condicion ')'
  92            | '(' ')'
  93            | cuerpo_condicion ')'
  94            | '(' cuerpo_condicion error

  95  cuerpo_condicion : expression comparador expression
  96                   | expression term_simple
  97                   | expression operador_suma term
  98                   | term

  99  comparador : '>'
 100             | '<'
 101             | EQ
 102             | LEQ
 103             | GEQ
 104             | NEQ
 105             | '='

 106  if : if_start cuerpo_if
 107     | IF error

 108  if_start : IF condicion

 109  cuerpo_if : cuerpo_ejecutable rama_else ENDIF ';'
 110            | cuerpo_ejecutable rama_else ENDIF error
 111            | cuerpo_ejecutable rama_else error
 112            | cuerpo_ejecutable rama_else ';'
 113            | rama_else ENDIF ';'

 114  rama_else :
 115            | else_start cuerpo_ejecutable
 116            | else_start

 117  else_start : ELSE

 118  do_while : do_while_start cuerpo_iteracion ';'
 119           | do_while_start cuerpo_iteracion error
 120           | do_while_start error

 121  do_while_start : DO

 122  cuerpo_iteracion : cuerpo_ejecutable fin_cuerpo_iteracion
 123                   | fin_cuerpo_iteracion
 124                   | cuerpo_ejecutable condicion

 125  fin_cuerpo_iteracion : WHILE condicion

 126  declaracion_funcion : inicio_funcion conjunto_parametros '{' function_body '}'
 127                      | inicio_funcion conjunto_parametros '{' '}'

 128  inicio_funcion : UINT ID
 129                 | UINT

 130  function_body : statement
