  23                 | error ';'

  24  statement : executable_statement
  25            | declarative_statement

  26  declarative_statement : declaration_of_variables
  27                        | declaracion_funcion punto_y_coma_opcional

  28  punto_y_coma_opcional :
  29                        | ';'

  30  cuerpo_ejecutable : executable_statement
  31                    | bloque_ejecutable

  32  bloque_ejecutable : '{' conjunto_sentencias_ejecutables '}'
  33                    | '{' '}'

  34  conjunto_sentencias_ejecutables : executable_statement
  35                                  | conjunto_sentencias_ejecutables executable_statement

  36  executable_statement : asignacion_simple
