 122  do_while_start : DO

 123  cuerpo_iteracion : cuerpo_ejecutable fin_cuerpo_iteracion
 124                   | fin_cuerpo_iteracion
 125                   | cuerpo_ejecutable condicion

 126  fin_cuerpo_iteracion : WHILE condicion

 127  declaracion_funcion : inicio_funcion conjunto_parametros '{' function_body '}'
