 148                    | RETURN expression ';'
 149                    | RETURN error

 150  inline_function_invocation : invocacion_funcion ';'
 151                             | invocacion_funcion error

 152  invocacion_funcion : function_start '(' lista_argumentos ')'

 153  function_start : variable

 154  lista_argumentos : argumento
