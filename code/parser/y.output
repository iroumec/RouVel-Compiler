 132  conjunto_parametros : '(' lista_parametros ')'
 133                      | '(' ')'

 134  lista_parametros : parametro_formal
 135                   | lista_parametros ',' parametro_formal
 136                   | parametro_vacio

 137  parametro_vacio : lista_parametros ','
 138                  | ',' parametro_formal

 139  parametro_formal : semantica_pasaje UINT ID
